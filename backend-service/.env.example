# 应用配置
APP_ENV=development
APP_NAME=AI医疗助手后端服务
APP_VERSION=2.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8010

# 数据库配置
# 开发环境: 使用Docker容器内的PostgreSQL
DATABASE_URL=postgresql://dev:dev123@localhost:5432/medical_ai
DATABASE_ECHO=false
DATABASE_REQUIRED=false

# Redis配置
# 开发环境: 使用Docker容器内的Redis
REDIS_URL=redis://localhost:6379/0

# JWT配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS配置（按需添加前端地址）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5928","http://127.0.0.1:5928"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================
# AI模型配置
# ============================================

# AI服务模式: local | cloud | hybrid
AI_SERVICE_MODE=local

# OpenAI配置（可选：仅在启用该 Provider 时需要）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Deepseek配置（可选；OpenAI兼容：基址不带 /v1，客户端会拼接 /chat/completions）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# DashScope (Aliyun) 配置 - OpenAI 兼容模式（基址需包含 /compatible-mode/v1）（可选）
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Claude配置（可选）
CLAUDE_API_KEY=
CLAUDE_API_BASE=https://api.anthropic.com
CLAUDE_MODEL=claude-3-opus-20240229

# 本地AI配置 (Ollama；可选，未安装则自动跳过)
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5vl:latest
LOCAL_AI_TIMEOUT=120
LOCAL_AI_MAX_RETRIES=3

# ============================================
# 多场景模型配置
# ============================================

# AI对话模型（默认走本地 provider 时）
AI_CHAT_MODEL=qwen2.5:32b
AI_CHAT_BASE_URL=http://localhost:11434
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_MAX_TOKENS=2000

# 检查项目推荐模型
EXAM_RECOMMENDATION_MODEL=qwen2.5:32b
EXAM_RECOMMENDATION_BASE_URL=http://localhost:11434
EXAM_RECOMMENDATION_TEMPERATURE=0.3
EXAM_RECOMMENDATION_MAX_TOKENS=2000

# 用药推荐模型
MEDICATION_RECOMMENDATION_MODEL=qwen2.5:32b
MEDICATION_RECOMMENDATION_BASE_URL=http://localhost:11434
MEDICATION_RECOMMENDATION_TEMPERATURE=0.3
MEDICATION_RECOMMENDATION_MAX_TOKENS=2000

# 诊断建议模型
DIAGNOSIS_SUGGESTION_MODEL=qwen2.5:32b
DIAGNOSIS_SUGGESTION_BASE_URL=http://localhost:11434
DIAGNOSIS_SUGGESTION_TEMPERATURE=0.5
DIAGNOSIS_SUGGESTION_MAX_TOKENS=2000

# 屏幕识别模型 (视觉模型)
SCREEN_RECOGNITION_MODEL=qwen2.5vl:latest
SCREEN_RECOGNITION_BASE_URL=http://localhost:11434
SCREEN_RECOGNITION_TEMPERATURE=0.1
SCREEN_RECOGNITION_MAX_TOKENS=1000

# ============================================
# Bisheng智能体平台配置
# ============================================

BISHENG_ENABLED=true
BISHENG_BASE_URL=http://localhost:7860
BISHENG_FRONTEND_URL=http://localhost:3001
BISHENG_IFRAME_PROXY_PORT=3002
BISHENG_USERNAME=
BISHENG_PASSWORD=
BISHENG_ACCESS_TOKEN=
BISHENG_TOKEN_EXPIRY=86400
BISHENG_DEFAULT_MODE=api

# ============================================
# OCR配置
# ============================================

# Tesseract配置
TESSERACT_LANG=chi_sim+eng
TESSERACT_CONFIG=--psm 6

# 图像处理配置
IMAGE_MAX_SIZE=1920x1080
IMAGE_QUALITY=80

# ============================================
# 语音服务配置
# ============================================

# Whisper配置
WHISPER_MODEL=whisper-large-v3
WHISPER_LANGUAGE=zh

# TTS配置
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=1.0
TTS_PITCH=1.0

# ============================================
# 医疗系统集成配置
# ============================================

# RIS/PACS配置
RIS_ENDPOINT=http://localhost:8080
RIS_API_KEY=

# HIS配置
HIS_ENDPOINT=http://localhost:8081
HIS_API_KEY=

# ============================================
# 性能和限流配置
# ============================================

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# 熔断配置
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# 并发配置
MAX_CONCURRENT_REQUESTS=100

# ============================================
# 对象存储配置 (MinIO/S3)
# ============================================

STORAGE_TYPE=local  # local | minio | s3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medical-ai

# ============================================
# 监控配置
# ============================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry (错误追踪)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
